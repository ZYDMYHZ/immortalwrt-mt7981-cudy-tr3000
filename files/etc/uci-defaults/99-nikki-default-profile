#!/bin/sh
# Nikki (mihomo) 首次开机默认配置：
#   - 默认启用 nikki（enabled=1）
#   - 默认 profile 指向内置的 file:nikki-default.yaml（含分类分流规则，离线可用）
# 说明：
#   * 仅在首次开机（uci-defaults 只跑一次）时生效，之后用户在 LuCI 的修改不会被覆盖。
#   * 不改 init 选项，交给 99_init_nikki 生成 api_secret 后自行清除。
#   * profile 内节点为占位节点，需在 LuCI 里改成自己的订阅或节点后才会真正出网。

[ -x /usr/bin/mihomo ] || exit 0
[ -f /etc/nikki/profiles/nikki-default.yaml ] || exit 0

uci -q batch <<-EOF
	set nikki.config.enabled=1
	set nikki.config.profile=file:nikki-default.yaml
	commit nikki
EOF

exit 0
